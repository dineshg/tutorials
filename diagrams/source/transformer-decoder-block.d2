classes: {
  state: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  norm: {
    style.fill: "#f6f8fa"
    style.stroke: "#6e7781"
    style.stroke-width: 2
  }
  attention: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  ffn: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
  output: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

x0: "token state x" {class: state}
ln1: "LayerNorm" {class: norm}
attn: "masked multi-head\nself-attention" {class: attention}
res1: "residual add\nx + attn(LN(x))" {class: output}
ln2: "LayerNorm" {class: norm}
ffn: "feed-forward network\nGELU/SwiGLU MLP" {class: ffn}
res2: "residual add\nblock output" {class: output}

x0 -> ln1
ln1 -> attn
attn -> res1
x0 -> res1: "skip"
res1 -> ln2
ln2 -> ffn
ffn -> res2
res1 -> res2: "skip"
