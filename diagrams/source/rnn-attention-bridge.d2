classes: {
  recurrent: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  bottleneck: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
  attention: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  result: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

encoder: "RNN encoder states\nh1, h2, h3, ..., hT" {class: recurrent}
single: "old seq2seq bottleneck\none final context vector" {class: bottleneck}
decoder_old: "decoder must recover\nall source details from one vector" {class: recurrent}

query: "decoder query\nwhat do I need now?" {class: attention}
scores: "attention scores\ncompare query to every encoder state" {class: attention}
context: "weighted context\nfocus on relevant source positions" {class: result}
decoder_new: "decoder step\nuses context + state" {class: result}

encoder -> single
single -> decoder_old
encoder -> scores: "keys / values"
query -> scores
scores -> context
context -> decoder_new
