classes: {
  source: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  memory: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  target: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

src1: "source token 1" {class: source}
src2: "source token 2" {class: source}
src3: "source token 3" {class: source}
context: "encoder final state\ncompressed summary" {class: memory}
dec1: "decoder step 1" {class: target}
dec2: "decoder step 2" {class: target}
dec3: "decoder step 3" {class: target}
eos: "EOS" {class: target}

src1 -> src2: "shared encoder cell"
src2 -> src3
src3 -> context
context -> dec1: "initial decoder memory"
dec1 -> dec2: "previous output feeds next step"
dec2 -> dec3
dec3 -> eos
