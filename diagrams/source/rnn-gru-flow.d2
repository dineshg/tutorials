classes: {
  input: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  gate: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
  candidate: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  blend: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
}

direction: right

h_prev: "previous hidden state\nh_{t-1}" {class: input}
x_t: "current input\nx_t" {class: input}
reset: "reset gate\nr_t" {class: gate}
update: "update gate\nz_t" {class: gate}
candidate: "candidate memory\nn_t = tanh(W_in x_t + b_in + r_t * (W_hn h + b_hn))" {class: candidate}
keep_old: "keep old memory\nz_t * h_{t-1}" {class: blend}
write_new: "write candidate\n(1 - z_t) * n_t" {class: blend}
sum: "add" {shape: circle; class: blend}
h_t: "new hidden state\nh_t" {class: gate}

h_prev -> reset
x_t -> reset
h_prev -> update
x_t -> update
h_prev -> candidate: "filtered by r_t"
x_t -> candidate
reset -> candidate
update -> keep_old
update -> write_new
h_prev -> keep_old
candidate -> write_new
keep_old -> sum
write_new -> sum
sum -> h_t
