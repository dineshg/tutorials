classes: {
  basic: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  gate: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
  memory: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  output: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: down

Vanilla_RNN: {
  label: "Vanilla RNN"
  v_in: "x_t, h_{t-1}" {class: basic}
  v_state: "one hidden state\nh_t = tanh(...)" {class: basic}
  v_out: "output uses h_t" {class: output}
  v_in -> v_state: "overwrite"
  v_state -> v_out
}

GRU: {
  label: "GRU"
  g_in: "x_t, h_{t-1}" {class: basic}
  g_gates: "reset + update gates" {class: gate}
  g_state: "blend old h\nwith candidate" {class: memory}
  g_out: "h_t is also output state" {class: output}
  g_in -> g_gates
  g_gates -> g_state
  g_state -> g_out
}

LSTM: {
  label: "LSTM"
  l_in: "x_t, h_{t-1}, c_{t-1}" {class: basic}
  l_gates: "forget + input + output gates" {class: gate}
  l_cell: "protected cell memory c_t" {class: memory}
  l_hidden: "exposed hidden state h_t" {class: output}
  l_in -> l_gates
  l_gates -> l_cell
  l_cell -> l_hidden: "o_t * tanh(c_t)"
}
