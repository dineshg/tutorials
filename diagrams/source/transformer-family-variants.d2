classes: {
  encoder: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  decoder: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  cross: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
  output: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

Encoder_only: {
  label: "Encoder-only"
  e_tokens: "input tokens" {class: encoder}
  e_stack: "bidirectional encoder stack\nno causal mask" {class: encoder}
  e_out: "class / embeddings / retrieval" {class: output}
  e_tokens -> e_stack
  e_stack -> e_out
}

Decoder_only: {
  label: "Decoder-only"
  d_prefix: "prefix tokens" {class: decoder}
  d_stack: "causal decoder stack\nfuture masked" {class: decoder}
  d_out: "next-token logits" {class: output}
  d_prefix -> d_stack
  d_stack -> d_out
}

Encoder_decoder: {
  label: "Encoder-decoder"
  src: "source tokens" {class: encoder}
  enc: "bidirectional encoder" {class: encoder}
  tgt: "target prefix" {class: decoder}
  dec: "causal decoder" {class: decoder}
  ca: "cross-attention\nqueries decoder, keys/values encoder" {class: cross}
  y: "target outputs" {class: output}
  src -> enc
  tgt -> dec
  enc -> ca
  dec -> ca
  ca -> y
}
