classes: {
  input: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  gate: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
  memory: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  candidate: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
}

direction: right

c_prev: "previous cell memory\nc_{t-1}" {class: memory}
signals: "current signals\nx_t and h_{t-1}" {class: input}
forget: "forget gate\nf_t" {class: gate}
input_gate: "input/write gate\ni_t" {class: gate}
candidate: "candidate content\ng_t" {class: candidate}
keep: "kept old memory\nf_t * c_{t-1}" {class: memory}
write: "new written memory\ni_t * g_t" {class: candidate}
c_t: "updated cell memory\nc_t = f_t*c_{t-1} + i_t*g_t" {class: memory}
output_gate: "output gate\no_t" {class: gate}
tanh: "squash cell\n tanh(c_t)" {class: input}
h_t: "exposed hidden state\nh_t = o_t * tanh(c_t)" {class: gate}

signals -> forget
signals -> input_gate
signals -> candidate
signals -> output_gate
c_prev -> keep
forget -> keep
input_gate -> write
candidate -> write
keep -> c_t
write -> c_t
c_t -> tanh
output_gate -> h_t
tanh -> h_t
