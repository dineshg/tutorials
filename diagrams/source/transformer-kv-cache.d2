classes: {
  prompt: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  cache: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  compute: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
  output: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

prompt: "prefill prompt\nmany tokens" {class: prompt}
prefill: "compute K/V once\nfor every layer" {class: compute}
cache: "KV cache\nstored per layer" {class: cache}
new_token: "new token" {class: prompt}
qkv: "compute q_new,k_new,v_new" {class: compute}
append: "append k_new,v_new\nto cache" {class: cache}
attend: "q_new attends to\ncached K,V" {class: compute}
logits: "next-token logits" {class: output}

prompt -> prefill
prefill -> cache
new_token -> qkv
qkv -> append
cache -> append
append -> attend
qkv -> attend: "q_new"
attend -> logits
