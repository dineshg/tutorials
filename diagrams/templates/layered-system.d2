classes: {
  layer: {
    style.fill: "#f6f8fa"
    style.stroke: "#d0d7de"
    style.stroke-width: 2
  }
  component: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  boundary: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
}

direction: down

Interface: {
  label: "Interface layer"
  class: layer
  API: "API / UI" {class: component}
}
Logic: {
  label: "Application logic"
  class: layer
  Service: "Service" {class: component}
  Policy: "Policy" {class: boundary}
}
Data: {
  label: "Data layer"
  class: layer
  Store: "Store" {class: component}
}

API -> Service
Service -> Policy
Service -> Store
