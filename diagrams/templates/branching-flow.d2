classes: {
  step: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  branch: {
    style.fill: "#f5f0ff"
    style.stroke: "#8250df"
    style.stroke-width: 2
  }
  outcome: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

Start: "Start" {class: step}
Decision: "Decision" {shape: diamond; class: branch}
left: "Path A" {class: outcome}
Right: "Path B" {class: outcome}
End: "Merged result" {class: step}

Start -> Decision
Decision -> left: "condition A"
Decision -> Right: "condition B"
left -> End
Right -> End
