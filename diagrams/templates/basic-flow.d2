classes: {
  source: {
    style.fill: "#eaf3ff"
    style.stroke: "#0969da"
    style.stroke-width: 2
  }
  process: {
    style.fill: "#fff8e6"
    style.stroke: "#bf8700"
    style.stroke-width: 2
  }
  result: {
    style.fill: "#f3f8f1"
    style.stroke: "#1a7f37"
    style.stroke-width: 2
  }
}

direction: right

A: "Input / concept" {class: source}
B: "Transformation" {class: process}
C: "Result / conclusion" {class: result}

A -> B: "changes into"
B -> C: "therefore"
